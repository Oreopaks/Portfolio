# ========= LLM =========
# Провайдер: mock (по умолчанию, без ключей) | gigachat | yandex
LLM_PROVIDER=mock

# --- GigaChat (Сбер, РФ, без VPN) ---
# Получить: https://developers.sber.ru/studio -> создать проект GigaChat API ->
# "Авторизационные данные" -> это base64(client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к сертификату Минцифры (см. DEPLOY.md). Для теста можно поставить False (небезопасно):
# GIGACHAT_CA=russian_trusted_root_ca.cer

# --- YandexGPT (альтернатива) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# ========= MVP1: Telegram-бот =========
TELEGRAM_BOT_TOKEN=

# ========= MVP4: Скаут заказов =========
# Telethon (чтение каналов): https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# StringSession Telethon (генерится один раз логином по номеру телефона + код из ТГ)
TG_SESSION=
# Каналы для мониторинга (через запятую, без @)
SCOUT_TG_CHANNELS=ipomogator,digitaltender,distantsiya
# Куда слать найденные заказы + черновики (твой бот-токен и chat_id)
SCOUT_NOTIFY_TOKEN=
SCOUT_NOTIFY_CHAT_ID=
# Фильтр
SCOUT_MIN_BUDGET=10000
SCOUT_KEYWORDS=бот,gpt,gigachat,нейросеть,n8n,парсинг,автоматизация,python,api
