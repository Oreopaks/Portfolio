# ========= LLM =========
# Провайдер: mock (по умолчанию, без ключей) | gigachat | yandex
LLM_PROVIDER=mock

# --- GigaChat (Сбер, РФ, без VPN) ---
# Получить: https://developers.sber.ru/studio -> создать проект GigaChat API ->
# "Авторизационные данные" -> это base64(client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к сертификату Минцифры (см. DEPLOY.md). Для теста можно поставить False (небезопасно):
# GIGACHAT_CA=russian_trusted_root_ca.cer

# --- YandexGPT (альтернатива) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# ========= MVP1: Telegram-бот (кофейня, @kryu_cafe_bot) =========
TELEGRAM_BOT_TOKEN=

# ========= Витрина: по боту на продукт (@BotFather) =========
KRYU_LEAD_TOKEN=   # MVP2 — квалификация заявок (@kryu_lead_bot)
KRYU_RAG_TOKEN=    # MVP3 — поиск по документам (@kryu_rag_bot)
KRYU_COPY_TOKEN=   # MVP5 — копирайтер (@kryu_copy_bot)
KRYU_SMM_TOKEN=    # MVP6 — SMM-менеджер (@kryu_smm_bot)

# ========= MVP4: Скаут заказов =========
# Telethon (чтение каналов): https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# StringSession Telethon (генерится один раз логином по номеру телефона + код из ТГ)
TG_SESSION=
# Каналы для мониторинга (через запятую, без @)
SCOUT_TG_CHANNELS=ipomogator,digitaltender,distantsiya
# Куда слать найденные заказы + черновики (твой бот-токен и chat_id)
SCOUT_NOTIFY_TOKEN=
SCOUT_NOTIFY_CHAT_ID=
# Фильтр
SCOUT_MIN_BUDGET=10000
SCOUT_KEYWORDS=бот,gpt,gigachat,нейросеть,n8n,парсинг,автоматизация,python,api

# ========= MVP7: Парсер цен конкурентов + бот сравнения =========
# ОТДЕЛЬНЫЙ бот @BotFather (НЕ переиспользовать ранее слитый токен!)
PRICE_BOT_TOKEN=
# chat_id админов через запятую (кому доступна команда /refresh)
PRICE_BOT_ADMINS=
# Файл базы цен (SQLite)
PRICESCOUT_DB=mvp7_price_scout/prices.db
# Instagram (заполнить ПОСЛЕ запуска ig_login.py)
IG_USERNAME=
IG_SETTINGS=mvp7_price_scout/ig_session.json   # сохранённая сессия instagrapi (пароль НЕ хранить)
